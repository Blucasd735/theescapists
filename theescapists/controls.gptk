# The Escapists - PortMaster / GPTOKEYB
# Primeira configuracao para teste no RG351MP / RK3326

# Analogico esquerdo controla o jogador com WASD
left_analog_up = w
left_analog_down = s
left_analog_left = a
left_analog_right = d

# A e B clicam normalmente na posicao atual do cursor
a = mouse_left
b = mouse_right
x = mouse_right
y = space

# Direcional controla o jogador com WASD
up = 7
up = repeat
down = 9
down = repeat
left = 
left = repeat
right = 
right = repeat

# Analogico direito controla o cursor do mouse
right_analog_up = mouse_movement_up
right_analog_down = mouse_movement_down
right_analog_left = mouse_movement_left
right_analog_right = mouse_movement_right

# Botoes auxiliares
start = esc
select = 8

# L1 e R1 permanecem exatamente como Q e E
l1 = q
r1 = e

# L2 diminui e R2 aumenta a selecao numerica de itens entre 1 e 6
l2 = f11
r2 = f10
r3 = mouse_left

# Ajuste do analogico para RK3326
deadzone_mode = sloped_scaled_axial
deadzone = 5000
deadzone_scale = 8
deadzone_delay = 16

# L1 reduz temporariamente a velocidade do cursor para clicar com precisao
mouse_slow_scale = 40

# Repeticao do direcional
repeat_delay = 300
repeat_interval = 50
